APP_NAME=PriorAuthVerifier
LOG_LEVEL=INFO

# Models
STRUCTURED_EXTRACTION_MODEL=gpt-6-luna
POLICY_REASONING_MODEL=gpt-6-sol
OCR_MODEL=mistral-ocr-latest
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Chunking
MAX_SECTION_TOKENS=900
SECTION_OVERLAP_TOKENS=100

# Procedure retrieval
BM25_TOP_K=10
DENSE_TOP_K=10
RRF_TOP_K=10
RRF_K=60
PATIENT_HEADING_TOP_K=10
PROCEDURE_RERANK_TOP_K=5
RERANK_TOP_K=5

# Policy / evidence retrieval
SECTION_NEIGHBOR_WINDOW=1
COMPACT_SECTION_CHARS=400
POLICY_BM25_TOP_K=40
POLICY_DENSE_TOP_K=15
POLICY_RERANK_TOP_K=5
EVIDENCE_SECTION_BM25_TOP_K=40
EVIDENCE_DENSE_TOP_K=10
EVIDENCE_RERANK_TOP_K=5
EVIDENCE_SOL_MAX_ITEMS_PER_BATCH=40
EVIDENCE_SOL_MAX_CONCURRENCY=3

# LLM token budgets
POLICY_LLM_MAX_CONTEXT_TOKENS=28000
POLICY_LLM_MAX_OUTPUT_TOKENS=16000
EVIDENCE_LLM_MAX_CONTEXT_TOKENS=20000
EVIDENCE_LLM_MAX_OUTPUT_TOKENS=8000

MIN_EXTRACTED_PAGE_CHARS=30
EMBEDDING_BATCH_SIZE=16

# Secrets (leave empty here; set in local .env only)
OPENAI_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=

HF_DOWNLOAD_MAX_WORKERS=8

LLM_REQUEST_TIMEOUT_SECONDS=120
OCR_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MAX_UPLOAD_SIZE_MB=50

CORS_ORIGINS=http://localhost:5173

# Observability (defaults keep normal runs quiet)
DEBUG_TRACE_ENABLED=false
PERFORMANCE_PROFILE_ENABLED=false

# In-memory prior authorization queue (one server process)
MAX_ACTIVE_ANALYSIS_JOBS=20
ANALYSIS_JOB_CONCURRENCY=2
